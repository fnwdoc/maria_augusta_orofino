mportant}.option-card{border:1px solid var(--ma-gray2);background:var(--ma-card);cursor:pointer;color:var(--ma-silver);border-radius:12px;font-weight:500;transition:all .2s}.option-card:hover{border-color:var(--ma-purple);color:var(--ma-white);background:#9b6fff0f;transform:translate(4px)}.progress-bar{background:linear-gradient(90deg,var(--ma-purple),var(--ma-purple2));transition:width .7s cubic-bezier(.4,0,.2,1)}input,select,textarea{background:var(--ma-card);border:1px solid var(--ma-gray2);color:var(--ma-white);border-radius:10px;outline:none;width:100%;padding:1rem 1.1rem;font-family:Plus Jakarta Sans,sans-serif;font-size:.95rem;transition:border-color .2s}input:focus,select:focus,textarea:focus{border-color:var(--ma-purple)}input::placeholder,textarea::placeholder{color:var(--ma-muted)}select option{background:var(--ma-card)}.gateway-card{border:1px solid var(--ma-gray2);background:var(--ma-card);cursor:pointer;border-radius:14px;padding:1.25rem;transition:all .2s}.gateway-card:hover{border-color:var(--ma-purple);background:#9b6fff0f;transform:translateY(-2px)}.gateway-card.selected{border-color:var(--ma-orange);background:#ff5c000f}@keyframes spin{to{transform:rotate(360deg)}}@keyframes fadeUp{0%{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}@keyframes slideInRight{0%{opacity:0;transform:translate(40px)}to{opacity:1;transform:none}}.fade-up{animation:.4s both fadeUp}.accent-line{background:linear-gradient(90deg,var(--ma-purple),var(--ma-orange),transparent);height:2px}</style><body class="flex items-start justify-center min-h-screen" style=padding:0><noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-XXXXXXX" height=0 style=visibility:hidden;display:none width=0></iframe></noscript><div class=w-full style=max-width:560px><div class="card-main overflow-hidden"><div style="border-bottom:1px solid var(--ma-gray);background:#08080f;padding:.85rem 1.25rem"><div style=justify-content:space-between;align-items:center;gap:.5rem;display:flex><div><div style=color:var(--ma-white);letter-spacing:.03em;font-size:.9rem;font-weight:900>MARIA AUGUSTA</div><div style=color:var(--ma-purple);letter-spacing:.14em;text-transform:uppercase;margin-top:-1px;font-size:.55rem;font-weight:700>BIZ INNOVATION</div></div><div style="text-transform:uppercase;letter-spacing:.08em;color:var(--ma-orange);background:#ff5c000f;border:1px solid #ff5c004d;border-radius:99px;padding:.3rem .75rem;font-size:.6rem;font-weight:700">Diagnóstico de Liderança</div></div></div><div class=accent-line></div><div style="background:linear-gradient(135deg,#08080f 0%,#120830 100%);padding:2rem 1.5rem 1.75rem;position:relative;overflow:hidden"><div style="pointer-events:none;background:radial-gradient(circle,#9b6fff12,#0000 70%);border-radius:50%;width:250px;height:250px;position:absolute;top:-60px;right:-60px"></div><p style=color:var(--ma-purple2);text-transform:uppercase;letter-spacing:.2em;margin-bottom:.85rem;font-size:.62rem;font-weight:700>PUV Score LST — Diagnóstico de Liderança<h1 style=color:var(--ma-white);font-size:clamp(1.2rem,5.5vw,1.75rem);font-weight:900;line-height:1.2>Descubra as chances do seu negócio lucrar melhor.</h1></div><div class=accent-line></div><div class=fade-up id=screen-intro style=padding:1.5rem><div style=background:var(--ma-gray);border-radius:12px;margin-bottom:1.25rem;padding:4px;display:flex><button onclick="introToggle('empresa')" style="cursor:pointer;text-transform:uppercase;letter-spacing:.05em;background:var(--ma-purple);color:#fff;border:none;border-radius:9px;flex:1;padding:.6rem .5rem;font-family:inherit;font-size:.75rem;font-weight:900;transition:all .25s" id=intro-toggle-empresa>🏢 Empresa / Líder</button><button onclick="introToggle('profissional')" style="cursor:pointer;text-transform:uppercase;letter-spacing:.05em;color:var(--ma-muted);background:0 0;border:none;border-radius:9px;flex:1;padding:.6rem .5rem;font-family:inherit;font-size:.75rem;font-weight:900;transition:all .25s" id=intro-toggle-profissional>🚀 Profissional</button></div><div id=intro-content-empresa><h2 style=text-transform:uppercase;letter-spacing:.06em;color:var(--ma-orange);margin-bottom:.85rem;font-size:.85rem;font-weight:800>Mais de 50 grandes organizações já transformaram sua liderança com Maria Augusta.</h2><p style=color:var(--ma-silver);margin-bottom:.75rem;font-size:1rem;line-height:1.7>Vale, Unilever, Itaú, TIM e Electrolux são alguns dos nomes que já passaram por palestras, workshops e programas de desenvolvimento com ela. TEDx Talker, autora de 4 livros e premiada pela ABTD como Personalidade do Ano em RH.</div><div id=intro-content-profissional style=display:none><h2 style=text-transform:uppercase;letter-spacing:.06em;color:var(--ma-orange);margin-bottom:.85rem;font-size:.85rem;font-weight:800>Em 6 meses, 12 pessoas sem saber o que fazer da vida viraram empreendedoras com negócios vendendo.</h2><p style=color:var(--ma-silver);margin-bottom:.75rem;font-size:1rem;line-height:1.7>Com mais de 20 anos de experiência em inovação, liderança e cultura organizacional, Maria Augusta Orofino ajuda profissionais a chegarem no próximo nível — com método e clareza.</div><p style=color:var(--ma-silver);margin-bottom:1.8rem;font-size:1rem;line-height:1.7>Este diagnóstico avalia em <strong style=color:var(--ma-white)>menos de 3 minutos</strong> onde estão os principais pontos de evolução — e o que pode ser feito para gerar mais resultado.<div class="flex flex-col gap-3 mb-6"><div style="background:var(--ma-card);border:1px solid var(--ma-gray);border-radius:12px;align-items:center;gap:1rem;padding:1rem;display:flex"><span style=flex-shrink:0;font-size:1.2rem>🏆</span><span style=color:var(--ma-silver);font-size:.88rem;font-weight:600>TEDx Talker · Autora de 4 livros · +50 grandes clientes</span></div><div style="background:var(--ma-card);border:1px solid var(--ma-gray);border-radius:12px;align-items:center;gap:1rem;padding:1rem;display:flex"><span style=flex-shrink:0;font-size:1.2rem>🎯</span><span style=color:var(--ma-silver);font-size:.88rem;font-weight:600>Vale, Unilever, Itaú, TIM, Electrolux — entre outros</span></div><div style="background:var(--ma-card);border:1px solid var(--ma-gray);border-radius:12px;align-items:center;gap:1rem;padding:1rem;display:flex"><span style=flex-shrink:0;font-size:1.2rem>⚡</span><span style=color:var(--ma-silver);font-size:.88rem;font-weight:600>Resultado em menos de 3 minutos</span></div></div><button class="w-full py-5 btn-action text-base shadow-xl flex items-center justify-center gap-3" id=btn-iniciar onclick=startQuiz()>INICIAR DIAGNÓSTICO <svg viewbox="0 0 24 24" fill=none height=18 stroke=currentColor stroke-linecap=round stroke-linejoin=round stroke-width=3 width=18 xmlns=http://www.w3.org/2000/svg><path d="m9 18 6-6-6-6"/></svg></button></div><div class=hidden id=screen-gateway style=padding:1.5rem><p style=text-transform:uppercase;letter-spacing:.12em;color:var(--ma-purple);margin-bottom:.75rem;font-size:.62rem;font-weight:900>Selecione seu perfil<h3 style=color:var(--ma-white);margin-bottom:1.25rem;font-size:1.1rem;font-weight:700;line-height:1.45>O que melhor descreve o que você busca hoje?</h3><div style=background:var(--ma-gray);border-radius:12px;margin-bottom:1.5rem;padding:4px;display:flex;position:relative><button onclick="toggleFluxo('empresa')" style="cursor:pointer;text-transform:uppercase;letter-spacing:.06em;background:var(--ma-purple);color:#fff;border:none;border-radius:9px;flex:1;padding:.65rem .5rem;font-family:inherit;font-size:.78rem;font-weight:900;transition:all .25s" id=toggle-empresa>🏢 Empresa / Líder</button><button onclick="toggleFluxo('profissional')" style="cursor:pointer;text-transform:uppercase;letter-spacing:.06em;color:var(--ma-muted);background:0 0;border:none;border-radius:9px;flex:1;padding:.65rem .5rem;font-family:inherit;font-size:.78rem;font-weight:900;transition:all .25s" id=toggle-profissional>🚀 Profissional</button></div><div style="animation:.3s both fadeUp" id=gw-content-empresa><div style="background:var(--ma-card);border:1px solid #9b6fff33;border-radius:14px;margin-bottom:1.25rem;padding:1.25rem"><p style=text-transform:uppercase;letter-spacing:.1em;color:var(--ma-purple2);margin-bottom:.6rem;font-size:.62rem;font-weight:900>Por que Maria Augusta?<p style=color:var(--ma-silver);font-size:.88rem;line-height:1.7>Mais de 50 grandes organizações — <strong style=color:var(--ma-white)>Vale, Unilever, Itaú, TIM</strong> — já transformaram sua cultura de liderança com ela. TEDx Talker, autora de 4 livros e premiada pela ABTD como <strong style=color:var(--ma-white)>Personalidade do Ano em RH</strong>.</div></div><div style="animation:.3s both fadeUp;display:none" id=gw-content-profissional><div style="background:var(--ma-card);border:1px solid #ff5c0033;border-radius:14px;margin-bottom:1.25rem;padding:1.25rem"><p style=text-transform:uppercase;letter-spacing:.1em;color:var(--ma-orange2);margin-bottom:.6rem;font-size:.62rem;font-weight:900>Resultado comprovado<p style=color:var(--ma-silver);font-size:.88rem;line-height:1.7>Em 6 meses, <strong style=color:var(--ma-white)>12 pessoas sem saber o que fazer da vida</strong> viraram empreendedoras com negócios vendendo. Com mais de 20 anos de experiência, Maria Augusta ajuda profissionais a chegarem no próximo nível — com método e clareza.</div></div><button class="btn-action w-full py-4 text-sm" onclick=selecionarFluxo() style=cursor:pointer;border:none;font-family:inherit>INICIAR MEU DIAGNÓSTICO →</button></div><div class=hidden id=screen-quiz style=padding:1.5rem><div style=margin-bottom:1.75rem><div style=justify-content:space-between;align-items:flex-end;margin-bottom:.5rem;display:flex><span style="text-transform:uppercase;letter-spacing:.12em;color:var(--ma-purple2);background:#9b6fff14;border:1px solid #9b6fff33;border-radius:6px;padding:.3rem .75rem;font-size:.62rem;font-weight:900" id=pilar-name>Dimensão</span><span id=quiz-percent style=color:var(--ma-muted);font-size:.82rem;font-weight:700>0%</span></div><div style=background:var(--ma-gray);border-radius:99px;height:3px;overflow:hidden><div class=progress-bar id=quiz-progress-bar style=border-radius:99px;width:0%;height:100%></div></div></div><h3 id=question-text style=color:var(--ma-white);margin-bottom:1.75rem;font-size:1.05rem;font-weight:700;line-height:1.5></h3><div class="flex flex-col gap-3" id=options-container></div><div style=justify-content:space-between;align-items:center;margin-top:2rem;display:flex><button style="text-transform:uppercase;letter-spacing:.06em;color:var(--ma-muted);cursor:pointer;visibility:hidden;background:0 0;border:none;align-items:center;gap:.4rem;font-size:.8rem;font-weight:700;display:flex" id=btn-prev onclick=prevQuestion()><svg viewbox="0 0 24 24" fill=none height=14 stroke=currentColor stroke-linecap=round stroke-linejoin=round stroke-width=2.5 width=14 xmlns=http://www.w3.org/2000/svg><path d="m15 18-6-6 6-6"/></svg> Voltar</button><button style="padding:.75rem 2rem;font-size:.82rem" class=btn-action disabled id=btn-next onclick=nextQuestion()>PRÓXIMA →</button></div></div><div class=hidden id=screen-lead style=text-align:center;padding:1.5rem><div style=margin-bottom:1.5rem><div style="background:#9b6fff14;border:1px solid #9b6fff33;border-radius:12px;justify-content:center;align-items:center;width:56px;height:56px;margin:0 auto 1rem;font-size:1.5rem;display:flex">📊</div><h2 style=text-transform:uppercase;color:var(--ma-white);margin-bottom:.4rem;font-size:1.2rem;font-weight:900>Diagnóstico Processado</h2><div style="background:linear-gradient(90deg,var(--ma-purple),var(--ma-orange));width:48px;height:2px;margin:.75rem auto"></div><p style=color:var(--ma-muted);font-size:.88rem;line-height:1.7>Informe seus dados para receber o resultado e o plano de evolução personalizado.</div><form class="flex flex-col gap-4 text-left" autocomplete=off id=lead-form onsubmit=generateResult(event)><div style="background:#9b6fff0f;border:1px solid #9b6fff33;border-radius:10px;justify-content:space-between;align-items:center;gap:.75rem;padding:.65rem 1rem;display:none" id=autofill-bar><span style=color:var(--ma-purple2);font-size:.75rem;font-weight:700>⚡ Último preenchimento salvo</span><div style=gap:.5rem;display:flex><button style="background:var(--ma-purple);color:#fff;cursor:pointer;border:none;border-radius:8px;padding:.35rem .85rem;font-family:inherit;font-size:.72rem;font-weight:900" onclick=autofill() type=button>Usar</button><button style="border:1px solid var(--ma-gray2);color:var(--ma-muted);cursor:pointer;background:0 0;border-radius:8px;padding:.35rem .7rem;font-family:inherit;font-size:.72rem;font-weight:700" onclick=clearSaved() type=button>Limpar</button></div></div><div><label style=text-transform:uppercase;letter-spacing:.12em;color:var(--ma-muted);margin-bottom:.5rem;font-size:.62rem;font-weight:900;display:block>Seu nome</label><input placeholder="Como prefere ser chamado(a)" autocomplete=off id=input-nome required></div><div><label style=text-transform:uppercase;letter-spacing:.12em;color:var(--ma-muted);margin-bottom:.5rem;font-size:.62rem;font-weight:900;display:block>WhatsApp com DDD</label><input placeholder="11 99999-9999" autocomplete=off id=input-whatsapp required type=tel></div><div><label style=text-transform:uppercase;letter-spacing:.12em;color:var(--ma-muted);margin-bottom:.5rem;font-size:.62rem;font-weight:900;display:block>E-mail</label><input autocomplete=off id=input-email placeholder=seu@email.com required type=email></div><div id=campos-empresa><div style=margin-bottom:1rem><label style=text-transform:uppercase;letter-spacing:.12em;color:var(--ma-muted);margin-bottom:.5rem;font-size:.62rem;font-weight:900;display:block>Tipo de organização</label><select autocomplete=off id=input-tipo-empresa><option disabled selected value>Selecione<option value="Empresa privada">Empresa privada<option value="Associação ou cooperativa">Associação ou cooperativa<option value="Entidade de classe">Entidade de classe<option value="Órgão público">Órgão público<option value="Startup / Scale-up">Startup / Scale-up<option value=Outro>Outro</select></div><div><label style=text-transform:uppercase;letter-spacing:.12em;color:var(--ma-muted);margin-bottom:.5rem;font-size:.62rem;font-weight:900;display:block>Tamanho da equipe</label><select autocomplete=off id=input-volume-empresa><option disabled selected value>Selecione<option value="Até 10 pessoas">Até 10 pessoas<option value="11 a 50 pessoas">11 a 50 pessoas<option value="51 a 200 pessoas">51 a 200 pessoas<option value="Mais de 200 pessoas">Mais de 200 pessoas</select></div></div><div id=campos-profissional style=display:none><div style=margin-bottom:1rem><label style=text-transform:uppercase;letter-spacing:.12em;color:var(--ma-muted);margin-bottom:.5rem;font-size:.62rem;font-weight:900;display:block>Seu momento profissional</label><select autocomplete=off id=input-tipo-profissional><option disabled selected value>Selecione<option value="Quero empreender — ainda estruturando">Quero empreender — ainda estruturando<option value="Já empreendo — quero crescer">Já empreendo — quero crescer<option value="Transição de carreira — 50+">Transição de carreira — 50+<option value="Executivo buscando novo propósito">Executivo buscando novo propósito<option value="Consultor / Especialista">Consultor / Especialista</select></div><div><label style=text-transform:uppercase;letter-spacing:.12em;color:var(--ma-muted);margin-bottom:.5rem;font-size:.62rem;font-weight:900;display:block>Sua ideia ou projeto em uma frase</label><textarea placeholder="Ex: quero criar uma consultoria de RH para pequenas empresas..." autocomplete=off id=input-ideia rows=2 style=resize:none></textarea></div></div><button class="w-full py-5 btn-action text-base mt-1">VER MEU DIAGNÓSTICO →</button></form></div><div style="text-align:center;padding:3.5rem 2rem;display:none" id=screen-loading><div style="border:3px solid var(--ma-gray);border-top-color:var(--ma-purple);border-radius:50%;width:52px;height:52px;margin:0 auto 1.5rem;animation:.9s linear infinite spin"></div><p style=color:var(--ma-purple2);text-transform:uppercase;letter-spacing:.15em;font-size:.8rem;font-weight:900>Analisando seu perfil...</div><div class=hidden id=screen-result style=padding:1.5rem><div style=text-align:center;margin-bottom:1.5rem><p style=text-transform:uppercase;letter-spacing:.2em;color:var(--ma-muted);margin-bottom:1.2rem;font-size:.62rem;font-weight:900>Índice de Evolução de Liderança<div style=justify-content:center;align-items:center;display:inline-flex;position:relative><svg height=176 style=transform:rotate(-90deg) width=176><defs><lineargradient id=gradient x1=0% x2=100% y1=0% y2=0%><stop id=grad-stop-1 offset=0% style=stop-color:#9b6fff /><stop id=grad-stop-2 offset=100% style=stop-color:#9b6fff /></lineargradient></defs><circle cx=88 cy=88 fill=none r=76 stroke=#1e1e32 stroke-width=10 /><circle cx=88 cy=88 fill=none id=score-circle r=76 stroke=url(#gradient) stroke-dasharray=477 stroke-dashoffset=477 stroke-linecap=round stroke-width=10 /></svg><div style=flex-direction:column;justify-content:center;align-items:center;display:flex;position:absolute;inset:0><span id=score-value style=color:var(--ma-purple);font-size:3rem;font-weight:900;line-height:1>0</span><span style=text-transform:uppercase;letter-spacing:.15em;color:var(--ma-muted);margin-top:2px;font-size:.6rem;font-weight:900>Score Final</span></div></div></div><div id=result-status style=text-align:center;text-transform:uppercase;border-radius:12px;margin-bottom:1.25rem;padding:1rem;font-size:.9rem;font-weight:900></div><div style=margin-bottom:1.5rem><p style=text-transform:uppercase;letter-spacing:.2em;color:var(--ma-muted);margin-bottom:.75rem;font-size:.62rem;font-weight:900>Escala de Maturidade<div id=escala-grid style=grid-template-columns:repeat(5,1fr);gap:4px;min-width:0;display:grid></div></div><div class=accent-line style=margin-bottom:1.5rem></div><div style="background:var(--ma-black);border:1px solid var(--ma-gray);border-radius:14px;margin-bottom:1.25rem;padding:1.25rem"><h4 style="text-transform:uppercase;letter-spacing:.1em;color:var(--ma-purple2);border-bottom:1px solid var(--ma-gray);margin-bottom:.75rem;padding-bottom:.6rem;font-size:.62rem;font-weight:900">Parecer — Maria Augusta Orofino</h4><div id=calc-summary style=color:var(--ma-silver);font-size:.88rem;line-height:1.75></div></div><div style="background:linear-gradient(135deg,#08080f,#120830);border:1px solid #9b6fff40;border-radius:14px;margin-bottom:1rem;padding:1.25rem;display:none" id=cta-qualificado><p style=text-transform:uppercase;letter-spacing:.1em;color:var(--ma-muted);margin-bottom:.35rem;font-size:.6rem;font-weight:900>Próximo Passo:<h4 style=color:var(--ma-white);margin-bottom:.5rem;font-size:.95rem;font-weight:900;line-height:1.3>Converse com Maria Augusta sobre o próximo nível</h4><p style=color:var(--ma-muted);margin-bottom:1.1rem;font-size:.82rem;line-height:1.6>Seu diagnóstico revela pontos de evolução reais. Uma conversa com Maria Augusta pode clarear o caminho e definir o primeiro passo concreto.</p><a href=# id=cta-vendedor style=color:#000;text-transform:uppercase;letter-spacing:.06em;background:#25d366;border-radius:12px;justify-content:center;align-items:center;gap:.6rem;width:100%;padding:1rem;font-size:.88rem;font-weight:900;text-decoration:none;display:flex target=_blank> <svg viewbox="0 0 24 24" fill=currentColor height=20 width=20><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg> FALAR COM MARIA AUGUSTA </a></div><div style="background:var(--ma-black);border:1px solid var(--ma-gray2);border-radius:14px;margin-bottom:1rem;padding:1.25rem;display:none" id=cta-desqualificado><p style=text-transform:uppercase;letter-spacing:.1em;color:var(--ma-muted);margin-bottom:.35rem;font-size:.6rem;font-weight:900>Parecer honesto:<h4 style=color:var(--ma-white);margin-bottom:.75rem;font-size:.95rem;font-weight:900;line-height:1.3>Você já está em alto nível — continue evoluindo.</h4><div style="background:var(--ma-card);border:1px solid var(--ma-gray);color:var(--ma-silver);border-radius:10px;margin-bottom:1rem;padding:.9rem 1rem;font-size:.83rem;line-height:1.7" id=dica-melhora></div><button class="btn-action flex items-center justify-center gap-2 w-full py-4 rounded-xl font-black text-sm uppercase tracking-wider mb-3" onclick=abrirPopupEducativo()>📖 Conheça os conteúdos de Maria Augusta</button><button style="border:1px solid var(--ma-gray2);width:100%;color:var(--ma-muted);text-transform:uppercase;cursor:pointer;background:0 0;border-radius:10px;padding:.75rem;font-family:inherit;font-size:.75rem;font-weight:700" onclick=tentarNovamente()>🔄 Refazer o diagnóstico</button></div><button style="cursor:pointer;width:100%;color:var(--ma-gray);text-transform:uppercase;letter-spacing:.1em;background:0 0;border:none;margin-top:.5rem;font-family:inherit;font-size:.6rem" onclick=abrirSenhaAdmin()>Área administrativa</button></div></div><div style="text-align:center;padding:1.5rem 1rem 3rem"><p style=color:var(--ma-gray2);letter-spacing:.12em;text-transform:uppercase;font-size:.62rem;font-weight:600>Maria Augusta Orofino · Liderança · Inovação · Negócios</div></div><div style="z-index:998;border-radius:20px;width:100%;max-width:330px;margin:0 auto;font-family:Plus Jakarta Sans,sans-serif;display:none;position:fixed;bottom:0;left:0;right:0;overflow:hidden;box-shadow:0 24px 60px #000000f2,0 0 0 1px #9b6fff26" id=popup-educativo><div style="border-bottom:1px solid var(--ma-gray);background:#08080f;justify-content:space-between;align-items:center;padding:1rem 1.1rem;display:flex"><div><p style=color:var(--ma-purple2);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.15rem;font-size:.58rem;font-weight:700>Maria Augusta — Portfólio<p style=color:var(--ma-white);font-size:.85rem;font-weight:800>Conheça como posso te ajudar</div><button onclick=fecharPopupEducativo() style=background:var(--ma-gray);color:var(--ma-muted);cursor:pointer;border:none;border-radius:50%;flex-shrink:0;justify-content:center;align-items:center;width:28px;height:28px;font-size:.85rem;display:flex>✕</button></div><div style=background:var(--ma-dark);max-height:60vh;padding:1.1rem;overflow-y:auto><div style="background:var(--ma-card);border:1px solid var(--ma-gray);border-radius:12px;margin-bottom:.9rem;padding:.9rem"><p style=color:var(--ma-orange);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.4rem;font-size:.68rem;font-weight:800>🎤 Palestras — maior impacto<p style=color:var(--ma-silver);font-size:.8rem;line-height:1.65>Inovação, liderança, cultura organizacional, gestão do tempo e futuro do trabalho. Para empresas, associações e cooperativas que querem inspirar e transformar equipes.</div><div style="background:var(--ma-card);border:1px solid var(--ma-gray);border-radius:12px;margin-bottom:.9rem;padding:.9rem"><p style=color:var(--ma-orange);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.4rem;font-size:.68rem;font-weight:800>🏢 Workshops In Company<p style=color:var(--ma-silver);font-size:.8rem;line-height:1.65>Accountability, liderança ágil, gestão do tempo, cultura organizacional e planejamento estratégico — aplicados diretamente na realidade da sua equipe.</div><div style="background:var(--ma-card);border:1px solid var(--ma-gray);border-radius:12px;margin-bottom:.9rem;padding:.9rem"><p style=color:var(--ma-orange);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.4rem;font-size:.68rem;font-weight:800>⏱ Curso — Tempo e o Fluxo da Vida<p style=color:var(--ma-silver);font-size:.8rem;line-height:1.65>Método AION — transforme sua relação com o tempo. Mais foco, menos urgência, equilíbrio real entre vida pessoal e resultados profissionais. Disponível na Hotmart.</div><div style="background:var(--ma-card);border:1px solid var(--ma-gray);border-radius:12px;margin-bottom:.9rem;padding:.9rem"><p style=color:var(--ma-orange);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.4rem;font-size:.68rem;font-weight:800>🚀 Mentoria Silver — para 50+<p style=color:var(--ma-silver);font-size:.8rem;line-height:1.65>Em 6 meses, 12 pessoas sem saber o que fazer da vida viraram empreendedoras com negócios vendendo. Transforme experiência em negócio com propósito.</div><button onclick=fecharPopupEducativo() style=background:linear-gradient(135deg,var(--ma-purple),#7b4fff);color:#fff;text-transform:uppercase;letter-spacing:.06em;cursor:pointer;border:none;border-radius:12px;width:100%;padding:.85rem;font-family:inherit;font-size:.82rem;font-weight:900>Entendido — Refazer o diagnóstico</button></div></div><div class="hidden fixed inset-0 z-50 flex items-center justify-center p-4" id=modal-admin style=background:#000000eb><div style="background:var(--ma-dark);border:1px solid var(--ma-gray2);border-radius:16px;width:100%;max-width:320px;padding:2rem"><h3 style=color:var(--ma-white);text-transform:uppercase;margin-bottom:.4rem;font-size:.95rem;font-weight:900>Acesso restrito</h3><p style=color:var(--ma-muted);margin-bottom:1.2rem;font-size:.75rem>Senha para refazer o diagnóstico.</p><input placeholder="Senha admin" autocomplete=off id=input-senha style=margin-bottom:.75rem type=password><p class=hidden id=senha-erro style=color:#ff4060;margin-bottom:.75rem;font-size:.75rem>Senha incorreta.<div style=gap:.75rem;display:flex><button style="background:var(--ma-gray);border:1px solid var(--ma-gray2);color:var(--ma-muted);cursor:pointer;border-radius:10px;flex:1;padding:.75rem;font-family:inherit;font-size:.85rem;font-weight:700" onclick=fecharModal()>Cancelar</button><button onclick=verificarSenha() style=background:var(--ma-purple);color:#fff;cursor:pointer;border:none;border-radius:10px;flex:1;padding:.75rem;font-family:inherit;font-size:.85rem;font-weight:900>Entrar</button></div></div></div><script>const SENHA_ADMIN=`1234`,CIRCUMFERENCE=477,FNW_SHEETS_URL=`https://script.google.com/macros/s/AKfycbweeYiQCqdRHTy9M74HPr8ThK2aVcV61FMjHVmklNV3LNJGJQP88frqgw306Qqd7nOQGg/exec`,SAVED_KEY=`ma_lead_last`;let fluxo=`empresa`,currentStep=0,userScores=[];
// ── PERGUNTAS FLUXO EMPRESA ──
const questions_empresa=[{pilar:`Perfil da Organização`,question:`Qual melhor descreve sua organização?`,options:[{txt:`Associação, cooperativa ou entidade de classe.`,score:20},{txt:`Empresa privada de médio ou grande porte.`,score:18},{txt:`Startup ou scale-up em crescimento.`,score:16},{txt:`Órgão público ou empresa de economia mista.`,score:14}]},{pilar:`Desafio de Liderança`,question:`Qual é o maior desafio de liderança na sua organização hoje?`,options:[{txt:`Engajar e reter talentos em tempos de mudança constante.`,score:20},{txt:`Implementar uma cultura de inovação que saia do papel.`,score:18},{txt:`Desenvolver líderes intermediários que assumam protagonismo.`,score:16},{txt:`Alinhar estratégia e execução com consistência.`,score:14}]},{pilar:`Engajamento`,question:`Como você avalia o nível de engajamento e protagonismo da sua equipe hoje?`,options:[{txt:`Baixo — precisamos de uma intervenção real e urgente.`,score:20},{txt:`Médio — existem ilhas de engajamento mas sem consistência.`,score:15},{txt:`Bom — mas ainda dependemos muito da liderança para manter o ritmo.`,score:8},{txt:`Alto — nossa equipe é autônoma e engajada.`,score:2}]},{pilar:`Cultura de Inovação`,question:`Sua organização tem dificuldade em implementar mudanças e novas ideias?`,options:[{txt:`Sim, muita — a resistência à mudança é um desafio crônico.`,score:20},{txt:`Alguma — ideias surgem mas a execução é lenta e fragmentada.`,score:14},{txt:`Pouca — temos abertura mas falta processo estruturado.`,score:7},{txt:`Não — temos uma cultura de inovação bem estabelecida.`,score:2}]},{pilar:`Desenvolvimento de Líderes`,question:`Sua organização investe regularmente no desenvolvimento de líderes?`,options:[{txt:`Não — isso nunca foi prioridade real no orçamento.`,score:20},{txt:`Raramente — acontece de forma pontual e sem consistência.`,score:15},{txt:`Às vezes — temos iniciativas mas sem um programa estruturado.`,score:8},{txt:`Sim — temos programas contínuos de desenvolvimento de liderança.`,score:2}]},{pilar:`Medição de Impacto`,question:`Você consegue medir o impacto das iniciativas de desenvolvimento de pessoas?`,options:[{txt:`Não — investimos mas sem saber o retorno real.`,score:20},{txt:`Parcialmente — temos feedbacks qualitativos mas sem métricas.`,score:14},{txt:`Em parte — medimos algumas coisas mas de forma incompleta.`,score:7},{txt:`Sim — temos indicadores claros de impacto e ROI.`,score:2}]},{pilar:`Urgência`,question:`Existe uma situação de mudança, crescimento ou transformação que torna o desenvolvimento de liderança urgente agora?`,options:[{txt:`Sim — temos uma transformação em curso que exige líderes preparados.`,score:20},{txt:`Sim — crescimento acelerado exigindo novos padrões de liderança.`,score:18},{txt:`Em parte — há pressão mas ainda não é uma urgência declarada.`,score:10},{txt:`Não — é uma necessidade de médio prazo ainda.`,score:4}]},{pilar:`Decisão`,question:`Quem toma a decisão de contratar palestras ou workshops na sua organização?`,options:[{txt:`Eu mesmo — tenho autonomia para contratar.`,score:20},{txt:`Eu e mais uma pessoa — decisão compartilhada.`,score:16},{txt:`Preciso passar por aprovação de diretoria ou comitê.`,score:10},{txt:`Sou influenciador — não tenho autonomia de contratação.`,score:5}]}],questions_profissional=[{pilar:`Momento Atual`,question:`Como você descreveria seu momento profissional hoje?`,options:[{txt:`Estou em transição — saí ou estou saindo de uma fase e não sei bem o próximo passo.`,score:20},{txt:`Tenho uma ideia mas não sei como estruturar ou por onde começar.`,score:18},{txt:`Já tenho algo iniciado mas sinto que estou travado sem avançar.`,score:15},{txt:`Estou crescendo mas quero acelerar com mais método e clareza.`,score:8}]},{pilar:`Clareza`,question:`Você sabe exatamente o que quer fazer — ou ainda está descobrindo seu caminho?`,options:[{txt:`Ainda estou descobrindo — tenho vontade mas não clareza.`,score:20},{txt:`Tenho uma direção geral mas muitas dúvidas sobre o caminho.`,score:16},{txt:`Sei o que quero mas não sei como executar.`,score:10},{txt:`Tenho bastante clareza — preciso de método e aceleração.`,score:5}]},{pilar:`Propósito`,question:`Você consegue explicar em uma frase o problema que quer resolver — ou o valor que quer gerar?`,options:[{txt:`Não — ainda estou tentando descobrir o que tenho de único para oferecer.`,score:20},{txt:`Tenho uma ideia mas não consigo articular de forma clara.`,score:15},{txt:`Consigo mas com dificuldade — precisa de mais refinamento.`,score:8},{txt:`Sim — tenho isso claro e consigo comunicar com facilidade.`,score:3}]},{pilar:`Tempo e Prioridade`,question:`Você tem tempo e energia reservados para trabalhar no seu projeto — ou ele fica sempre para depois?`,options:[{txt:`Sempre fica para depois — a vida operacional consome tudo.`,score:20},{txt:`Às vezes consigo — mas sem consistência nem método.`,score:14},{txt:`Tenho algum tempo mas não estou usando bem.`,score:8},{txt:`Tenho tempo e estou usando de forma estruturada.`,score:2}]},{pilar:`Principal Trava`,question:`O que mais te impede de avançar hoje?`,options:[{txt:`Medo — de errar, de não dar certo, de julgamento.`,score:20},{txt:`Falta de clareza — não sei por onde começar.`,score:18},{txt:`Falta de método — tenho vontade mas não estrutura.`,score:15},{txt:`Falta de tempo ou recursos.`,score:10}]},{pilar:`Validação`,question:`Você já conversou com pessoas que poderiam ser seus clientes ou público — para entender se sua ideia resolve uma dor real?`,options:[{txt:`Não — ainda não tive essa conversa.`,score:20},{txt:`Apenas com amigos e família — não com o público real.`,score:15},{txt:`Sim, com algumas pessoas — mas de forma não estruturada.`,score:8},{txt:`Sim — e tive feedbacks muito concretos que me ajudaram.`,score:2}]},{pilar:`Plano e Visão`,question:`Daqui a 1 ano, você consegue imaginar onde quer estar — e tem algum plano para chegar lá?`,options:[{txt:`Não — o futuro está muito nebuloso ainda.`,score:20},{txt:`Tenho uma visão mas nenhum plano concreto.`,score:15},{txt:`Tenho visão e algumas ações mas sem estrutura clara.`,score:8},{txt:`Sim — tenho visão clara e um plano ativo.`,score:2}]}];
// ── GATEWAY ──
function introToggle(tipo){fluxo=tipo;let btnEmp=document.getElementById(`intro-toggle-empresa`),btnProf=document.getElementById(`intro-toggle-profissional`),contEmp=document.getElementById(`intro-content-empresa`),contProf=document.getElementById(`intro-content-profissional`);toggleFluxo(tipo),tipo===`empresa`?(btnEmp.style.background=`var(--ma-purple)`,btnEmp.style.color=`#fff`,btnProf.style.background=`transparent`,btnProf.style.color=`var(--ma-muted)`,contEmp.style.display=`block`,contProf.style.display=`none`):(btnProf.style.background=`var(--ma-orange)`,btnProf.style.color=`#fff`,btnEmp.style.background=`transparent`,btnEmp.style.color=`var(--ma-muted)`,contProf.style.display=`block`,contEmp.style.display=`none`)}function startQuiz(){currentStep=0,userScores=[],document.getElementById(`screen-intro`).classList.add(`hidden`),document.getElementById(`screen-gateway`).classList.remove(`hidden`),window.dataLayer=window.dataLayer||[],window.dataLayer.push({event:`quiz_start`})}function toggleFluxo(tipo){fluxo=tipo;
// Toggle buttons
let btnEmpresa=document.getElementById(`toggle-empresa`),btnProf=document.getElementById(`toggle-profissional`),contEmpresa=document.getElementById(`gw-content-empresa`),contProf=document.getElementById(`gw-content-profissional`);tipo===`empresa`?(btnEmpresa.style.background=`var(--ma-purple)`,btnEmpresa.style.color=`#fff`,btnProf.style.background=`transparent`,btnProf.style.color=`var(--ma-muted)`,contEmpresa.style.display=`block`,contProf.style.display=`none`):(btnProf.style.background=`var(--ma-orange)`,btnProf.style.color=`#fff`,btnEmpresa.style.background=`transparent`,btnEmpresa.style.color=`var(--ma-muted)`,contProf.style.display=`block`,contEmpresa.style.display=`none`)}function escolherFluxo(tipo){toggleFluxo(tipo)}function selecionarFluxo(){
// Show correct form fields
let isEmpresa=fluxo===`empresa`;document.getElementById(`campos-empresa`).style.display=isEmpresa?`block`:`none`,document.getElementById(`campos-profissional`).style.display=isEmpresa?`none`:`block`,document.getElementById(`screen-gateway`).classList.add(`hidden`),document.getElementById(`screen-quiz`).classList.remove(`hidden`),renderQuestion()}
// ── QUIZ ──
function getQuestions(){return fluxo===`empresa`?questions_empresa:questions_profissional}function renderQuestion(){let qs=getQuestions(),q=qs[currentStep],pct=Math.round((currentStep+1)/qs.length*100);document.getElementById(`question-text`).innerText=q.question,document.getElementById(`pilar-name`).innerText=q.pilar,document.getElementById(`quiz-percent`).innerText=pct+`%`,document.getElementById(`quiz-progress-bar`).style.width=pct+`%`;let container=document.getElementById(`options-container`);container.innerHTML=``,q.options.forEach((opt,i)=>{let div=document.createElement(`div`);div.className=`option-card`,div.style.padding=`1rem 1.1rem`,div.style.fontSize=`.88rem`,div.innerText=opt.txt,div.onclick=()=>selectOption(i,opt.score),container.appendChild(div)}),document.getElementById(`btn-prev`).style.visibility=currentStep===0?`hidden`:`visible`,document.getElementById(`btn-next`).disabled=userScores[currentStep]===void 0}function selectOption(i,score){userScores[currentStep]={index:i,score},renderQuestion(),setTimeout(nextQuestion,380)}function nextQuestion(){let qs=getQuestions();currentStep<qs.length-1?(currentStep++,renderQuestion()):(document.getElementById(`screen-quiz`).classList.add(`hidden`),document.getElementById(`screen-lead`).classList.remove(`hidden`),loadSavedBar(),window.dataLayer=window.dataLayer||[],window.dataLayer.push({event:`formulario_aberto`}))}function prevQuestion(){currentStep>0&&(currentStep--,renderQuestion())}
// ── RESULTADO ──
