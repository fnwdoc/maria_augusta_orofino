 tem <strong style="color:var(--ma-white)">potencial relevante de benefício</strong> com uma mentoria. Você tem vontade — mas ainda falta estrutura e método para avançar com consistência. O próximo passo pode mudar o jogo.</p>`,document.getElementById(`cta-qualificado`).style.display=`block`,document.getElementById(`cta-desqualificado`).style.display=`none`):pct>=35?(statusEl.innerText=`◎ EM DESENVOLVIMENTO`,statusEl.style.cssText=`padding:1rem;border-radius:12px;margin-bottom:1.25rem;text-align:center;font-weight:900;text-transform:uppercase;font-size:.9rem;background:#FFD000;color:#000000;border:none;`,summaryEl.innerHTML=`<p><strong style="color:var(--ma-white)">${primeiroNome}</strong>, seu score de <strong style="color:var(--ma-orange)">${pct}</strong> indica que você já tem uma base sólida — o benefício de uma mentoria seria pontual e de refinamento. Conheça os conteúdos de Maria Augusta para continuar evoluindo no seu ritmo.</p>`,document.getElementById(`cta-qualificado`).style.display=`none`,document.getElementById(`cta-desqualificado`).style.display=`block`,gerarDicaMelhora()):(statusEl.innerText=`✦ ALTO NÍVEL CONSOLIDADO`,statusEl.style.cssText=`padding:1rem;border-radius:12px;margin-bottom:1.25rem;text-align:center;font-weight:900;text-transform:uppercase;font-size:.9rem;background:#FF4060;color:#ffffff;border:none;`,summaryEl.innerHTML=`<p><strong style="color:var(--ma-white)">${primeiroNome}</strong>, seu score de <strong style="color:var(--ma-orange)">${pct}</strong> indica alta maturidade de liderança. Neste momento, o benefício de uma mentoria seria de refinamento, não de transformação. Refaça o diagnóstico em 90 dias para mapear novos vetores de crescimento.</p>`,document.getElementById(`cta-qualificado`).style.display=`none`,document.getElementById(`cta-desqualificado`).style.display=`block`,gerarDicaMelhora());let vendedorMsg=`🔔 *NOVO LEAD — MARIA AUGUSTA OROFINO*\n\n👤 *Nome:* ${nome}\n📱 *WhatsApp:* ${whatsapp}\n📧 *E-mail:* ${email}\n🔀 *Fluxo:* ${isEmpresa?`🏢 Empresa/Líder`:`🚀 Profissional`}${isEmpresa?`\n🏢 *Organização:* ${tipo}\n👥 *Equipe:* ${volume}`:`\n💼 *Momento:* ${tipo}${ideia?`\n💡 *Ideia:* ${ideia}`:``}`}\n\n📊 *Score:* ${pct}/100\n🏷 *Classificação:* ${classificacao}\n\n_Lead gerado via PUV Score LST — Maria Augusta Orofino_`;document.getElementById(`cta-vendedor`).href=`https://wa.me/5511975893206?text=${encodeURIComponent(vendedorMsg)}`}async function enviarParaFNW(dados){let params=new URLSearchParams(dados).toString();try{await fetch(`https://script.google.com/macros/s/AKfycbweeYiQCqdRHTy9M74HPr8ThK2aVcV61FMjHVmklNV3LNJGJQP88frqgw306Qqd7nOQGg/exec?`+params,{method:`GET`,mode:`no-cors`})}catch(err){console.warn(`FNW Sheets:`,err)}}function animateScore(target){let circle=document.getElementById(`score-circle`),valueEl=document.getElementById(`score-value`),start=performance.now(),duration=2e3;function ease(t){return t<.5?4*t*t*t:(t-1)*(2*t-2)*(2*t-2)+1}function update(now){let progress=Math.min((now-start)/2e3,1),e=ease(progress);valueEl.innerText=Math.floor(e*target),circle.style.strokeDashoffset=477-e*(target/100)*477,progress<1&&requestAnimationFrame(update)}requestAnimationFrame(update)}function getFaixaColor(score){return score<=20?{cor:`#FF4060`}:score<=35?{cor:`#FF8800`}:score<=55?{cor:`#FFD000`}:score<=75?{cor:`#9B6FFF`}:{cor:`#00DD66`}}function renderEscala(score){let faixas=[{range:`0–20`,min:0,max:20,label:`Base Inicial`,desc:`Poucos gaps`,cor:`#FF4060`},{range:`21–35`,min:21,max:35,label:`Estruturando`,desc:`Crescendo`,cor:`#FF8800`},{range:`36–55`,min:36,max:55,label:`Evoluindo`,desc:`Bom momento`,cor:`#FFD000`},{range:`56–75`,min:56,max:75,label:`Alto Potencial`,desc:`Gaps relevantes`,cor:`#9B6FFF`},{range:`76–100`,min:76,max:100,label:`Máximo Potencial`,desc:`Evolução real`,cor:`#00DD66`}],{cor}=getFaixaColor(score);document.getElementById(`grad-stop-1`).style.stopColor=cor,document.getElementById(`grad-stop-2`).style.stopColor=cor,document.getElementById(`score-value`).style.color=cor;let grid=document.getElementById(`escala-grid`);grid.innerHTML=faixas.map(f=>{let active=score>=f.min&&score<=f.max,bgCard=active?f.cor:`#1e1e32`,lightBg=[`#00DD66`,`#FFD000`],textColor=active?lightBg.includes(f.cor)?`#000`:`#fff`:f.cor,subColor=active?lightBg.includes(f.cor)?`rgba(0,0,0,.65)`:`rgba(255,255,255,.75)`:`#666`;return`<div style="border-radius:8px;padding:6px 4px;text-align:center;border:${active?`2px`:`1px`} solid ${active?f.cor:`#2a2a44`};background:${bgCard};overflow:hidden;min-width:0">
      <div style="font-size:.48rem;color:${subColor};margin-bottom:1px;line-height:1.2">${f.range}</div>
      <div style="font-size:.54rem;font-weight:800;color:${textColor};margin-bottom:1px;line-height:1.2;word-break:break-word">${f.label}</div>
      <div style="font-size:.44rem;color:${subColor};line-height:1.2">${f.desc}</div>
      ${active?`<div style="font-size:.44rem;font-weight:900;color:${textColor};margin-top:2px">← AQUI</div>`:``}
    </div>`}).join(``)}function gerarDicaMelhora(){let dicas=fluxo===`empresa`?[`Associações e cooperativas têm potencial enorme de impacto quando a liderança está alinhada e inspirada.`,`O maior desafio de liderança que você identificou pode ser o ponto de partida para uma transformação real.`,`Equipes mais engajadas começam com líderes que criam espaço para protagonismo — e isso é uma habilidade treinável.`,`Uma cultura de inovação que sai do papel começa com processos e não com inspiração pontual.`,`Programas contínuos de desenvolvimento geram 3x mais impacto do que treinamentos pontuais.`,`O que não se mede não se melhora — indicadores de desenvolvimento de pessoas são fundamentais.`,`Transformações bem-sucedidas têm líderes preparados para navegar a mudança com clareza e confiança.`]:[`A transição de carreira é mais fluida quando você tem clareza de propósito e um plano de ação estruturado.`,`Clareza não vem antes da ação — ela vem durante. O primeiro passo é o que ativa tudo.`,`Quem não consegue explicar sua proposta em uma frase ainda não a entendeu o suficiente.`,`Proteger tempo para o que importa é uma decisão — não uma circunstância.`,`O medo é um sinal de que você está próximo de algo importante. Não some com ele — atravesse-o com método.`,`Validação real vem de conversas com o público, não de aprovação de amigos e família.`,`Visão sem plano é sonho. Plano sem visão é burocracia. Você precisa dos dois.`],lowestIdx=0,lowestScore=999;userScores.forEach((s,i)=>{s&&s.score<lowestScore&&(lowestScore=s.score,lowestIdx=i)});let el=document.getElementById(`dica-melhora`);el&&(el.innerHTML=`<strong style="color:var(--ma-white);display:block;margin-bottom:.4rem">💡 Próximo ponto de evolução:</strong>${dicas[Math.min(lowestIdx,dicas.length-1)]}`)}function tentarNovamente(){currentStep=0,userScores=[],document.getElementById(`screen-result`).classList.add(`hidden`),document.getElementById(`screen-intro`).classList.remove(`hidden`),document.getElementById(`cta-qualificado`).style.display=`none`,document.getElementById(`cta-desqualificado`).style.display=`none`}function abrirPopupEducativo(){let popup=document.getElementById(`popup-educativo`);window.innerWidth>=400?(popup.style.left=`auto`,popup.style.right=`1.5rem`,popup.style.bottom=`1.5rem`,popup.style.margin=`0`,popup.style.maxWidth=`330px`):(popup.style.left=`0`,popup.style.right=`0`,popup.style.bottom=`0`,popup.style.margin=`0`,popup.style.borderRadius=`20px 20px 0 0`,popup.style.maxWidth=`100%`),popup.style.display=`block`,popup.style.animation=`none`,popup.offsetHeight,popup.style.animation=`slideInRight .35s cubic-bezier(.34,1.56,.64,1) both`}function fecharPopupEducativo(){document.getElementById(`popup-educativo`).style.display=`none`,event&&event.target&&event.target.innerText&&event.target.innerText.includes(`Refazer`)&&tentarNovamente()}function loadSavedBar(){try{JSON.parse(localStorage.getItem(SAVED_KEY))&&(document.getElementById(`autofill-bar`).style.display=`flex`)}catch{}}function autofill(){try{let saved=JSON.parse(localStorage.getItem(SAVED_KEY));if(!saved)return;document.getElementById(`input-nome`).value=saved.nome||``,document.getElementById(`input-whatsapp`).value=saved.whatsapp||``,document.getElementById(`input-email`).value=saved.email||``}catch{}}function clearSaved(){localStorage.removeItem(SAVED_KEY),document.getElementById(`autofill-bar`).style.display=`none`}function saveLeadLocally(nome,whatsapp,email,tipo,volume){try{localStorage.setItem(SAVED_KEY,JSON.stringify({nome,whatsapp,email,tipo,volume}))}catch{}}function abrirSenhaAdmin(){document.getElementById(`modal-admin`).classList.remove(`hidden`),document.getElementById(`input-senha`).value=``,document.getElementById(`senha-erro`).classList.add(`hidden`),setTimeout(()=>document.getElementById(`input-senha`).focus(),100)}function fecharModal(){document.getElementById(`modal-admin`).classList.add(`hidden`)}function verificarSenha(){document.getElementById(`input-senha`).value===`1234`?(fecharModal(),location.reload()):(document.getElementById(`senha-erro`).classList.remove(`hidden`),document.getElementById(`input-senha`).value=``)}document.addEventListener(`keydown`,e=>{e.key===`Enter`&&!document.getElementById(`modal-admin`).classList.contains(`hidden`)&&verificarSenha(),e.key===`Escape`&&fecharModal()});</script>
